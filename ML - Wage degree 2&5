
install.packages("ISLR")
library(ISLR)

data(Wage)
str(Wage)

model2 <- lm(wage ~ poly(age, 2), data = Wage)
model5 <- lm(wage ~ poly(age, 5), data = Wage)

age.grid <- seq(min(Wage$age), max(Wage$age), length = 100)

pred2 <- predict(model2, newdata = data.frame(age = age.grid))
pred5 <- predict(model5, newdata = data.frame(age = age.grid))

plot(Wage$age, Wage$wage,
     xlab = "Age",
     ylab = "Wage",
     main = "Polynomial Regression Degree 2 and 5",
     pch = 20, col = "gray")

lines(age.grid, pred2, col = "blue", lwd = 2)
lines(age.grid, pred5, col = "red", lwd = 2)

legend("topleft",
       legend = c("Degree 2", "Degree 5"),
       col = c("blue", "red"),
       lwd = 2)
