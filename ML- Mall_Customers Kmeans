
# K-Means Clustering on Mall Customers Dataset

data <- read.csv("C:/Users/santo/Downloads/Mall_Customers.csv")

head(data)
names(data)

# Select required columns
cluster_data <- data[, c(
  "Annual.Income..k..",
  "Spending.Score..1.100."
)]

cluster_data <- na.omit(cluster_data)

# Split data into 70:30 ratio
set.seed(123)
index <- sample(1:nrow(cluster_data),
                0.7 * nrow(cluster_data))

train <- cluster_data[index, ]
test <- cluster_data[-index, ]

# Elbow Method
wcss <- numeric(10)

for (k in 1:10) {
  model <- kmeans(train, centers=k, nstart=25)
  wcss[k] <- model$tot.withinss
}

plot(1:10, wcss, type="b", pch=19,
     xlab="Number of Clusters (K)",
     ylab="WCSS",
     main="Elbow Method")

# K-Means Clustering
set.seed(123)
km <- kmeans(train, centers=5, nstart=25)

print(km$cluster)
print(km$centers)
print(table(km$cluster))

# PCA on test data
pca <- prcomp(test, scale.=TRUE)

# Assign test observations to nearest trained center
test_cluster <- apply(test, 1, function(x) {
  distances <- apply(km$centers, 1, function(center) {
    sum((x - center)^2)
  })
  which.min(distances)
})

# PCA Visualization
plot(pca$x[,1], pca$x[,2],
     col=test_cluster, pch=19,
     xlab="Principal Component 1",
     ylab="Principal Component 2",
     main="K-Means Clustering using PCA")
