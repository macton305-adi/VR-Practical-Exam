
install.packages("ISLR")
library(ISLR)

data(Wage)
str(Wage)

set.seed(123)
train <- sample(1:nrow(Wage), 0.7*nrow(Wage))
trainData <- Wage[train, ]
testData <- Wage[-train, ]

model <- lm(wage ~ poly(age, 4), data = trainData)

age.grid <- seq(min(Wage$age), max(Wage$age), length = 100)

pred <- predict(model, newdata = data.frame(age = age.grid))

plot(Wage$age, Wage$wage,
     xlab = "Age",
     ylab = "Wage",
     main = "Polynomial Regression Degree 4",
     pch = 20, col = "gray")

lines(age.grid, pred, col = "red", lwd = 2)

test.pred <- predict(model, newdata = testData)
test.error <- mean((testData$wage - test.pred)^2)

print(test.error)
