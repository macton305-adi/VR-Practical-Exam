
# PCA on USArrests Dataset

data(USArrests)

head(USArrests)
str(USArrests)

pca <- prcomp(USArrests, scale = TRUE)

summary(pca)

pca$x[, 1:2]

plot(pca$x[, 1], pca$x[, 2],
     xlab = "First Principal Component",
     ylab = "Second Principal Component",
     main = "PCA on USArrests Dataset",
     pch = 19,
     col = "blue")

text(pca$x[, 1], pca$x[, 2],
     labels = rownames(USArrests),
     pos = 3,
     cex = 0.6)

# Interpretation
# PC1 and PC2 represent the observations
# in two-dimensional space.
# Nearby states have similar crime patterns.
